# Copy to .env and adjust for your service.
# Address where the gRPC server is reachable (host:port)
GRPC_ADDR=localhost:50051

# Full names of the services as reported by reflection.
# Check with: grpcurl -plaintext localhost:50051 list
GRPC_ACCOUNT_SERVICE=account.v1.AccountService
GRPC_AUTH_SERVICE=auth.v1.AuthService

# Path to the sqlite file the service writes to.
# When running via docker-compose this must be under the same mounted
# volume the service's DATABASE_URL points into (see docker-compose.yml) —
# for local (non-docker) runs, point this at wherever DATABASE_URL resolves to.
SQLITE_PATH=./data/app.db

